# TLS terminates at Cloudflare; the tunnel talks plain HTTP to Caddy.
{
	admin off
	auto_https off
}

http://{$PILL_HOST} {
	request_body {
		max_size 64KB
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# Metrics stay internal.
	@internal path /debug/*
	handle @internal {
		respond 404
	}

	@api path /classify /soften /coach /healthz
	handle @api {
		reverse_proxy api:8090
	}

	handle {
		respond 404
	}
}
