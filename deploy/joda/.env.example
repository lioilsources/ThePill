# Public hostname routed by the Cloudflare tunnel (decided by Olin).
PILL_HOST=<pill-host>
# Shared secret; the app sends it as "Authorization: Bearer <token>".
PILL_TOKEN=<random-32-chars>
# LiteLLM on SPARK (address lives only in this .env, never in the repo).
PILL_LLM_BASE_URL=http://<spark-lan-ip>:8080/v1
PILL_LLM_API_KEY=<litellm-key>
PILL_LLM_MODEL=openclaw-default
