# Generated on JODA by deploy.sh on the first run; never leaves the host.
# Public hostname routed by the Cloudflare tunnel.
PILL_HOST=<pill-host>
# Shared secret; the app sends it as "Authorization: Bearer <token>".
PILL_TOKEN=<random>
# LiteLLM gateway on SPARK (LAN, no virtual keys: the key stays empty).
# deploy.sh fills the URL on the first run from PILL_LLM_BASE_URL in the
# repo's local .env. Empty URL = no LLM: pill-core fails open (degraded) and
# the keyboard stays silent; the same happens while the broker has no LLM loaded.
PILL_LLM_BASE_URL=
PILL_LLM_API_KEY=
PILL_LLM_MODEL=openclaw-default
PILL_LLM_TIMEOUT=10s
